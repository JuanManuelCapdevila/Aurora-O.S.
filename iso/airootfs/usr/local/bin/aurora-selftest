#!/usr/bin/env bash
# Autoprueba de la imagen: la ejecuta CI arrancando el ISO en QEMU con
# `aurora.selftest` en la línea de comandos del kernel. Imprime el resultado
# en la consola serie y apaga.

set -uo pipefail
failures=0
check() {
  local desc="$1"; shift
  if "$@" >/dev/null 2>&1; then
    echo "AURORA-CHECK ok   $desc"
  else
    echo "AURORA-CHECK FAIL $desc"
    failures=$((failures + 1))
  fi
}

for cmd in node aurora gamescope cage es-de umu-run gamemoderun mangohud foot nmtui \
           ryzenadj dialog rsync aurora-logs aurora-display wlr-randr aurora-settings aurora-padkeys aurora-hotkeys wpctl busctl aurora-tool arch-chroot bootctl sgdisk udisksctl; do
  check "comando $cmd" command -v "$cmd"
done
check "python-evdev (control en herramientas)" python3 -c "import evdev"
check "pygame y aurora_nm (Ajustes gráficos)" python3 -c "import pygame, sys; sys.path.insert(0, '/usr/lib/aurora/python'); import aurora_nm"
check "glifos de Ajustes" test -f /usr/share/aurora/es-de/settings/icons/wifi.png
check "regla de uinput" test -f /etc/udev/rules.d/70-aurora-uinput.rules
check "regla de polkit para Wi-Fi" test -f /etc/polkit-1/rules.d/50-aurora-networkmanager.rules
check "Vulkan RADV 64 bits" test -f /usr/lib/libvulkan_radeon.so
check "Vulkan RADV 32 bits" test -f /usr/lib32/libvulkan_radeon.so
check "manifiesto ICD de RADV" sh -c 'ls /usr/share/vulkan/icd.d/radeon_icd*.json'
check "libvulkan 32 bits" test -f /usr/lib32/libvulkan.so.1
check "usuario player" id player
root_sin_clave() { [[ -z "$(getent shadow root | cut -d: -f2)" ]]; }
check "root entra sin contraseña (consola de diagnóstico)" root_sin_clave
check "player en video e input" sh -c 'id -nG player | grep -qw video && id -nG player | grep -qw input'
check "home de player" test "$(stat -c %U /home/player 2>/dev/null)" = player
check "aurora help" runuser -u player -- env HOME=/home/player aurora help
check "aurora export-esde" runuser -u player -- env HOME=/home/player aurora export-esde
check "es_systems.xml generado" test -f /home/player/ES-DE/custom_systems/es_systems.xml
check "herramientas de ES-DE" test -f "/usr/share/aurora/tools/Instalar Aurora.sh"
check "lista de Ajustes sin contar como juegos" grep -q nogamecount /home/player/ES-DE/gamelists/aurora/gamelist.xml
check "tema aurora-material" test -f /usr/share/aurora/es-de/themes/aurora-material/theme.xml
check "íconos de herramientas" test -f /usr/share/aurora/es-de/media/aurora/covers/Terminal.png
check "tema enlazado en ES-DE" test -f /home/player/ES-DE/themes/aurora-material/theme.xml
check "configuración regional es_ES (menús de ES-DE)" sh -c "locale -a | grep -qi '^es_ES.utf8'"
check "configuración inicial de ES-DE" grep -q aurora-material /home/player/ES-DE/settings/es_settings.xml
check "greetd habilitado" systemctl is-enabled greetd.service
check "NetworkManager activo" systemctl is-active NetworkManager.service
check "sesión de greetd" grep -q 'user = "player"' /etc/greetd/config.toml
# Información útil en el log de CI (no cuenta como chequeo).
echo "AURORA-INFO locales: $(locale -a 2>/dev/null | tr '\n' ' ')"
echo "AURORA-INFO aurora-locale: $(systemctl is-active aurora-locale.service)"
echo "AURORA-INFO icd: $(find /usr/share/vulkan/icd.d/ -maxdepth 1 -name '*.json' -printf '%f ' 2>/dev/null)"

if ((failures == 0)); then
  echo "AURORA-SELFTEST: OK"
else
  echo "AURORA-SELFTEST: FAIL ($failures)"
fi
systemctl poweroff
