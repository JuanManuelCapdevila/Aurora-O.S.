#!/usr/bin/env bash
# Instala Aurora desde el USB live en un disco: el SSD interno o una microSD
# (instalar en la microSD deja Windows intacto en el SSD).
#
# Copia el sistema del live tal cual (la imagen squashfs), genera el initramfs
# normal e instala systemd-boot. EL DISCO ELEGIDO SE BORRA COMPLETO.
#
# Uso: sudo aurora-install

set -euo pipefail

TITLE="Instalar Aurora"
BOOTMNT=/run/archiso/bootmnt
TARGET=/mnt/aurora-install
MIN_SIZE=$((16 * 1024 * 1024 * 1024))

msg() { dialog --title "$TITLE" --msgbox "$1" 12 64; }
fail() { clear; echo "Error: $*" >&2; read -rp $'\nPresioná Enter para salir...' _; exit 1; }

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"
command -v dialog >/dev/null || fail "falta dialog"
if [[ ! -d /run/archiso ]]; then
  msg "Aurora ya está instalado: este instalador solo funciona arrancando desde el USB."
  exit 0
fi

SRC="$(findmnt -rno TARGET -t squashfs | head -n1)"
[[ -n "$SRC" && -x "$SRC/usr/bin/bash" ]] || fail "no se encontró la imagen del sistema (squashfs)"

# Lee un campo de una línea de `lsblk -P` (KEY="valor").
field() { [[ "$1" =~ (^|\ )$2=\"([^\"]*)\" ]] && printf '%s' "${BASH_REMATCH[2]}"; }

# Disco desde el que arrancamos (el USB), para no ofrecerlo como destino.
BOOT_SRC="$(findmnt -no SOURCE "$BOOTMNT" || true)"
BOOT_DISK=""
if [[ -n "$BOOT_SRC" ]]; then
  BOOT_DISK="$(lsblk -npo PKNAME "$BOOT_SRC" 2>/dev/null | head -n1)"
  BOOT_DISK="${BOOT_DISK:-$BOOT_SRC}"
fi

items=()
while read -r line; do
  name="$(field "$line" NAME)"
  [[ "$(field "$line" TYPE)" == "disk" && "$name" != *zram* && "$name" != "$BOOT_DISK" ]] || continue
  bytes="$(field "$line" SIZE)"
  ((bytes >= MIN_SIZE)) || continue
  model="$(field "$line" MODEL)"
  tran="$(field "$line" TRAN)"
  items+=("$name" "$(numfmt --to=iec "$bytes") ${tran:-?} ${model:--}")
done < <(lsblk -dbPpno NAME,TYPE,SIZE,MODEL,TRAN -e 7,11)

((${#items[@]})) || fail "no hay discos de 16 GB o más donde instalar"

DISK="$(dialog --title "$TITLE" --stdout --menu \
  "Elegí el disco donde instalar Aurora.\n\nmmcblk = microSD (Windows queda intacto)\nnvme/sda = SSD interno (SE BORRA WINDOWS)" \
  18 72 6 "${items[@]}")" || { clear; exit 0; }

dialog --title "$TITLE" --defaultno --yesno \
  "Se va a BORRAR TODO el contenido de:\n\n  $DISK ($(lsblk -dno SIZE,MODEL "$DISK"))\n\n¿Continuar?" 12 64 || { clear; exit 0; }
dialog --title "$TITLE" --defaultno --yesno \
  "Última confirmación: ¿borrar $DISK e instalar Aurora?" 8 64 || { clear; exit 0; }

clear
set -x

# Desmonta todo lo que use el disco (ej. una microSD automontada).
for part in $(lsblk -lnpo NAME "$DISK" | tail -n +2); do
  umount -q "$part" 2>/dev/null || true
done

wipefs -af "$DISK"
sgdisk --zap-all "$DISK"
sgdisk -n1:0:+512M -t1:ef00 -c1:AURORA_EFI -n2:0:0 -t2:8300 -c2:AURORA_ROOT "$DISK"
partprobe "$DISK" || true
udevadm settle

mapfile -t PARTS < <(lsblk -lnpo NAME,TYPE "$DISK" | awk '$2 == "part" {print $1}')
((${#PARTS[@]} == 2)) || fail "no aparecieron las particiones nuevas"
ESP="${PARTS[0]}"
ROOT="${PARTS[1]}"

mkfs.fat -F 32 -n AURORA_EFI "$ESP"
mkfs.ext4 -F -L aurora_root "$ROOT"

mkdir -p "$TARGET"
mount "$ROOT" "$TARGET"
mkdir -p "$TARGET/boot"
mount "$ESP" "$TARGET/boot"
trap 'umount -R "$TARGET" 2>/dev/null || true' EXIT

# Copia el sistema limpio (la imagen original, no los cambios hechos en el live).
rsync -aHAX --info=progress2 "$SRC/" "$TARGET/"

# Proton y su runtime, si ya se descargaron en el live: así el sistema
# instalado no los vuelve a bajar.
for dir in .local/share/Steam/compatibilitytools.d .local/share/umu Games/.proton-check; do
  if [[ -d "/home/player/$dir" ]]; then
    mkdir -p "$TARGET/home/player/$(dirname "$dir")"
    rsync -aHAX "/home/player/$dir/" "$TARGET/home/player/$dir/" && echo "Copiado ~/$dir"
  fi
done
[[ -f /home/player/.local/state/aurora/proton-status ]] &&
  install -Dm644 /home/player/.local/state/aurora/proton-status "$TARGET/home/player/.local/state/aurora/proton-status"
chown -R --reference="$TARGET/home/player" "$TARGET/home/player/.local" "$TARGET/home/player/Games" 2>/dev/null || true

# Kernel: el del paquete linux de la imagen, que coincide con sus módulos y
# está también cuando se arrancó cargando todo en RAM (sin el USB montado).
KERNEL="$(find "$TARGET/usr/lib/modules" -mindepth 2 -maxdepth 2 -name vmlinuz | sort -V | tail -n1)"
[[ -n "$KERNEL" ]] || KERNEL="$(find "$BOOTMNT" -name 'vmlinuz-linux' 2>/dev/null | head -n1)"
[[ -n "$KERNEL" ]] || fail "no se encontró el kernel para instalar"
cp -f "$KERNEL" "$TARGET/boot/vmlinuz-linux"

# El initramfs del live arranca desde el ISO: se reemplaza por uno normal.
rm -f "$TARGET/etc/mkinitcpio.conf.d/archiso.conf"
cat > "$TARGET/etc/mkinitcpio.d/linux.preset" <<'EOF'
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default')
default_image="/boot/initramfs-linux.img"
EOF

genfstab -U "$TARGET" > "$TARGET/etc/fstab"
: > "$TARGET/etc/machine-id"

ROOT_PARTUUID="$(blkid -s PARTUUID -o value "$ROOT")"

arch-chroot "$TARGET" /bin/bash -euxo pipefail -s <<EOF
mkinitcpio -P
bootctl --esp-path=/boot install || bootctl --esp-path=/boot --no-variables install
mkdir -p /boot/loader/entries
cat > /boot/loader/loader.conf <<'LOADER'
default aurora.conf
timeout 0
console-mode keep
editor no
LOADER
cat > /boot/loader/entries/aurora.conf <<'ENTRY'
title   Aurora O.S.
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=PARTUUID=$ROOT_PARTUUID rw quiet loglevel=3 $(cat /etc/aurora/kernel-params 2>/dev/null)
ENTRY
pacman-key --init
pacman-key --populate archlinux
EOF

set +x
sync
if dialog --title "$TITLE" --yesno \
  "Aurora quedó instalado en $DISK.\n\nRetirá el USB y elegí ese disco en el arranque.\n\n¿Reiniciar ahora?" 12 64; then
  umount -R "$TARGET"
  trap - EXIT
  systemctl reboot
fi
clear
