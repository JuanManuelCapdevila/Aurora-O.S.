#!/usr/bin/env bash
# Genera las configuraciones regionales de /etc/locale.gen si falta alguna.
# ES-DE necesita es_ES.UTF-8 para mostrar sus menús en español. Normalmente ya
# vienen en la imagen; esto cubre el caso en que no (tarda unos segundos).

set -uo pipefail

available="$(locale -a 2>/dev/null | tr '[:upper:]' '[:lower:]')"
missing=0
while read -r name _; do
  [[ -z "$name" || "$name" == \#* ]] && continue
  normalized="$(tr '[:upper:]' '[:lower:]' <<<"${name/UTF-8/utf8}")"
  grep -qx "$normalized" <<<"$available" || missing=1
done < /etc/locale.gen

if ((missing)); then
  echo "Generando configuraciones regionales..."
  locale-gen
fi
