#!/usr/bin/env bash
# Fase 0: genera un reporte del hardware de la consola para docs/hardware.md.
# Se puede correr desde cualquier Linux (USB live incluido). No modifica nada.
#
# Uso: aurora-hw-report [archivo-de-salida]

set -uo pipefail

# --summary: solo el resumen por la salida estándar (lo usa Ajustes → Hardware).
if [[ "${1:-}" == "--summary" ]]; then
  SUMMARY_ONLY=1
else
  OUT="${1:-hw-report-$(date +%Y%m%d-%H%M).txt}"
fi

section() { printf '\n===== %s =====\n' "$1"; }
run() {
  printf '$ %s\n' "$*"
  if command -v "$1" >/dev/null; then "$@" 2>&1; else echo "(no instalado: $1)"; fi
}

# Resumen en una pantalla: lo que más sirve para ajustar la imagen a la consola.
summary() {
  section "Resumen"
  printf 'CPU:      %s\n' "$(lscpu 2>/dev/null | sed -n 's/^\(Model name\|Nombre del modelo\): *//p' | head -n1)"
  printf 'RAM:      %s\n' "$(free -h 2>/dev/null | awk '/^(Mem|Mem\.):/ {print $2}')"
  printf 'GPU:      %s\n' "$(lspci 2>/dev/null | grep -Ei 'vga|display|3d' | cut -d: -f3- | head -n1)"
  lspci -k 2>/dev/null | grep -A3 -Ei 'network|wireless' | awk '
    /Network|Wireless/ { sub(/^[^:]*: /, ""); name = $0 }
    /Kernel driver in use/ { sub(/.*: /, ""); printf "Wi-Fi:    %s (driver: %s)\n", name, $0; name = "" }
    END { if (name != "") printf "Wi-Fi:    %s (SIN DRIVER)\n", name }'
  for c in /sys/class/drm/card*-*; do
    [[ "$(cat "$c/status" 2>/dev/null)" == connected ]] || continue
    printf 'Pantalla: %s %s\n' "${c##*/card?-}" "$(head -n1 "$c/modes" 2>/dev/null)"
  done
  grep -E '^N: Name' /proc/bus/input/devices 2>/dev/null | sed 's/^N: Name="\(.*\)"/\1/' |
    grep -Ei 'pad|x-box|xbox|controller|joystick|touch|keyboard|mouse' | sed 's/^/Entrada:  /'
  for b in /sys/class/power_supply/BAT*; do
    [[ -r "$b/capacity" ]] && printf 'Batería:  %s%% (%s)\n' "$(cat "$b/capacity")" "$(cat "$b/status" 2>/dev/null)"
  done
  echo
  echo "(Detalle completo abajo: Espacio = página siguiente, b = anterior, q = salir)"
}

if [[ -n "${SUMMARY_ONLY:-}" ]]; then
  summary
  exit 0
fi

{
  summary

  section "Sistema"
  uname -a
  cat /etc/os-release 2>/dev/null | head -n 3

  section "CPU"
  run lscpu
  section "Memoria"
  run free -h

  section "PCI (GPU, Wi-Fi, audio) con drivers"
  run lspci -nnk
  section "USB (control, Bluetooth)"
  run lsusb

  section "Pantalla: conectores DRM y modos"
  for c in /sys/class/drm/card*-*; do
    [[ -e "$c/status" ]] || continue
    printf '%s: %s\n' "$(basename "$c")" "$(cat "$c/status")"
    sed 's/^/    /' "$c/modes" 2>/dev/null
  done
  echo "Si el modo preferido es vertical (ej. 720x1280), el panel necesita rotación."

  section "Vulkan"
  run vulkaninfo --summary

  section "Dispositivos de entrada"
  grep -E '^(N: Name|H: Handlers)' /proc/bus/input/devices 2>/dev/null

  section "Batería"
  for b in /sys/class/power_supply/*; do
    [[ -e "$b/type" ]] || continue
    printf '%s (%s)\n' "$(basename "$b")" "$(cat "$b/type")"
    for f in status capacity energy_full energy_full_design charge_full charge_full_design; do
      [[ -r "$b/$f" ]] && printf '    %s = %s\n' "$f" "$(cat "$b/$f")"
    done
  done

  section "Sensores"
  run sensors

  section "Almacenamiento"
  run lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT,MODEL
} > "$OUT"

echo "Reporte guardado en $OUT"
