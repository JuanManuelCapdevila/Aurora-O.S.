#!/bin/sh
# Sesión de consola de Aurora: ES-DE a pantalla completa sobre cage (compositor
# Wayland de una sola ventana). Cada juego abre su propio gamescope anidado.
# Todo lo que imprime queda en ~/.local/state/aurora/session.log (ver aurora-logs).

export XDG_CURRENT_DESKTOP=aurora
export XDG_SESSION_TYPE=wayland
# greetd no carga /etc/locale.conf: sin esto las apps avisan "invalid locale".
if [ -z "${LANG:-}" ] && [ -r /etc/locale.conf ]; then
  # shellcheck source=/dev/null
  . /etc/locale.conf
fi
export LANG="${LANG:-C.UTF-8}"

LOG_DIR="$HOME/.local/state/aurora"
mkdir -p "$LOG_DIR"
exec >>"$LOG_DIR/session.log" 2>&1
echo "=== $(date '+%F %T') inicio de sesión"

# TDP: el último modo elegido en Ajustes → Energía (o equilibrado). Si ryzenadj
# no está disponible la sesión arranca igual.
POWER_MODE="$(cat "$HOME/.config/aurora/power-mode" 2>/dev/null || true)"
aurora power "${POWER_MODE:-balanced}" || true

# Mantiene la lista de juegos de ES-DE al día con la biblioteca.
aurora export-esde || true

# Proton se descarga solo la primera vez que hay Internet (en segundo plano).
aurora-proton-auto &

# Opción "Instalar Aurora" del menú de arranque del USB: abre el instalador
# antes que la interfaz. Si se cancela, sigue el modo live normal.
if [ -d /run/archiso ] && grep -qw aurora.install /proc/cmdline; then
  echo "=== $(date '+%F %T') instalador (aurora.install)"
  INSTALLER='aurora-display apply; exec aurora-tool sudo aurora-install'
  start=$(date +%s)
  # Si cage no pudo arrancar (sin aceleración 3D) se reintenta con software;
  # si el usuario canceló el instalador, no.
  if ! cage -s -- sh -c "$INSTALLER" && [ $(($(date +%s) - start)) -lt 5 ]; then
    WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 cage -s -- sh -c "$INSTALLER" || true
  fi
fi

# Ajustes → Buscar juegos deja este archivo para pedir que ES-DE se reabra y
# lea los juegos nuevos.
RESTART_FLAG="$LOG_DIR/restart-frontend"
rm -f "$LOG_DIR/running-game.json"

# Dentro de cage: rotación, atajos del control durante los juegos (menú rápido)
# y ES-DE. aurora-hotkeys termina solo cuando se cierra ES-DE.
INNER='aurora-display apply; aurora-hotkeys & exec es-de'

while :; do
  rm -f "$RESTART_FLAG"
  # -s permite cambiar de terminal virtual (Ctrl+Alt+F2) para mantenimiento.
  start=$(date +%s)
  cage -s -- sh -c "$INNER"
  status=$?

  # Si falló enseguida (ej. una máquina virtual sin aceleración 3D), se reintenta
  # con el renderizado por software de wlroots.
  if [ "$status" -ne 0 ] && [ $(($(date +%s) - start)) -lt 15 ]; then
    echo "=== cage/ES-DE terminó con $status: reintento con WLR_RENDERER=pixman"
    WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 cage -s -- sh -c "$INNER"
    status=$?
  fi

  [ -e "$RESTART_FLAG" ] || break
  echo "=== $(date '+%F %T') reabriendo ES-DE (juegos nuevos)"
  aurora export-esde || true
done

echo "=== $(date '+%F %T') fin de sesión ($status)"
exit "$status"
