#!/usr/bin/env bash
# Busca juegos en las microSD y memorias USB conectadas y los registra.
#
# Convención: cada juego en su propia carpeta dentro de "Juegos" en la raíz de
# la tarjeta o del USB (ej. /Juegos/GTA San Andreas/gta_sa.exe). También se
# revisa ~/Juegos en el disco interno.
#
# Uso: aurora-scan-games [--pause]

set -uo pipefail

pause() { [[ "${1:-}" == "--pause" ]] && read -rp $'\nPresioná Enter para volver...' _; }

# En "Probar Aurora" el sistema se lee del USB de arranque: si se sacó (por
# ejemplo para conectar el de los juegos), ningún programa se puede abrir.
# Se revisa solo con comandos internos de bash, que siguen funcionando.
boot_media_missing() {
  [[ -d /run/archiso && ! -d /run/archiso/copytoram ]] || return 1
  local dev mnt _
  while read -r dev mnt _; do
    [[ "$mnt" == /run/archiso/bootmnt ]] && { [[ -b "$dev" ]] && return 1 || return 0; }
  done </proc/mounts
  return 1
}
if boot_media_missing; then
  echo "Se desconectó el USB de Aurora."
  echo "En el modo \"Probar Aurora\" el sistema se lee de ese USB y no se puede sacar."
  echo "Volvé a conectarlo y reiniciá. Para usar otro USB con juegos, arrancá con"
  echo "\"Probar Aurora en memoria\" o instalá Aurora en la microSD o el SSD."
  pause "${1:-}"
  exit 1
fi

echo "Montando tarjetas y memorias USB..."
# Lee un campo de una línea de `lsblk -P` (KEY="valor"). El ancla evita que
# TYPE coincida dentro de FSTYPE.
field() { [[ "$1" =~ (^|\ )$2=\"([^\"]*)\" ]] && printf '%s' "${BASH_REMATCH[2]}"; }
while read -r line; do
  name="$(field "$line" NAME)"
  fstype="$(field "$line" FSTYPE)"
  [[ "$(field "$line" TYPE)" == "part" && -n "$fstype" && -z "$(field "$line" MOUNTPOINT)" ]] || continue
  [[ "$(field "$line" RM)" == "1" || "$(field "$line" HOTPLUG)" == "1" || "$name" == /dev/mmcblk* ]] || continue
  [[ "$fstype" == "iso9660" || "$fstype" == "swap" ]] && continue
  if err="$(udisksctl mount --no-user-interaction -b "$name" 2>&1)"; then
    echo "  montado $name ($fstype)"
  else
    echo "  no se pudo montar $name ($fstype): ${err##*: }"
    # NTFS que Windows dejó "sucio" (sin quitar el USB de forma segura).
    [[ "$fstype" == "ntfs" ]] && echo "  Conectalo en Windows, quitalo con \"Expulsar\" y volvé a probar."
  fi
done < <(lsblk -Ppno NAME,TYPE,RM,HOTPLUG,FSTYPE,MOUNTPOINT)

# La carpeta puede llamarse Juegos, juegos o JUEGOS. (nocaseglob no sirve: bash
# solo ignora mayúsculas en las partes del patrón que tienen comodines.)
shopt -s nullglob
JUEGOS='[Jj][Uu][Ee][Gg][Oo][Ss]'
# shellcheck disable=SC2206  # el patrón tiene que expandirse como glob
dirs=(/run/media/"${USER:-$(id -un)}"/*/$JUEGOS/*/ "$HOME"/$JUEGOS/*/)

if ((${#dirs[@]} == 0)); then
  echo
  echo "No se encontraron juegos."
  echo "Copiá cada juego en su propia carpeta dentro de una carpeta \"Juegos\""
  echo "en la raíz de la microSD o del USB, y volvé a intentar."
  pause "${1:-}"
  exit 0
fi

added=0
failed=0
for dir in "${dirs[@]}"; do
  dir="${dir%/}"
  if out="$(aurora add "$dir" --if-new 2>&1)"; then
    case "$out" in
      "Ya registrado"*) ;;
      *) added=$((added + 1)); echo "Agregado: $(basename "$dir")" ;;
    esac
  else
    failed=$((failed + 1))
    echo "No se pudo agregar $(basename "$dir"): ${out#aurora: }"
  fi
done

echo "Juegos nuevos: $added · Con errores: $failed · Revisados: ${#dirs[@]}"
((added > 0)) && echo "Para verlos en el menú hay que recargar la interfaz."
pause "${1:-}"

# Éxito si no hubo errores al agregar (sin juegos nuevos también es éxito).
((failed == 0))
