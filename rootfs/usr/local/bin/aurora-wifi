#!/usr/bin/env python3
"""Wi-Fi de Aurora: busca redes, las lista por señal y se conecta.

Pensado para manejarse con el control (vía aurora-padkeys: cruceta = flechas,
A = Enter, B = Esc, X = Borrar, Y = Tab) o con un teclado. Las contraseñas se
escriben con un teclado en pantalla. Usa NetworkManager (nmcli).
"""

import curses
import locale
import os
import re
import subprocess

os.environ.setdefault("ESCDELAY", "25")

SPECIAL_KEYS = {
    curses.KEY_UP: "up", curses.KEY_DOWN: "down", curses.KEY_LEFT: "left", curses.KEY_RIGHT: "right",
    curses.KEY_PPAGE: "pgup", curses.KEY_NPAGE: "pgdn", curses.KEY_ENTER: "enter",
    curses.KEY_BACKSPACE: "back",
}
CHAR_KEYS = {"\n": "enter", "\r": "enter", "\x1b": "esc", "\t": "tab", "\x7f": "back", "\x08": "back"}


def read_key(scr):
    """Devuelve 'up', 'down', 'left', 'right', 'pgup', 'pgdn', 'enter', 'esc',
    'tab', 'back' o el carácter escrito."""
    while True:
        try:
            key = scr.get_wch()
        except curses.error:
            continue
        if isinstance(key, int):
            if key in SPECIAL_KEYS:
                return SPECIAL_KEYS[key]
            continue
        return CHAR_KEYS.get(key, key)


# --- NetworkManager -----------------------------------------------------------

def split_terse(line):
    """Separa una línea de `nmcli -t`: los campos van con ':' y nmcli escapa
    ':' y '\\' dentro de los valores con una barra invertida."""
    fields, buf, escaped = [], [], False
    for ch in line:
        if escaped:
            buf.append(ch)
            escaped = False
        elif ch == "\\":
            escaped = True
        elif ch == ":":
            fields.append("".join(buf))
            buf = []
        else:
            buf.append(ch)
    fields.append("".join(buf))
    return fields


def parse_networks(output):
    """Lista de redes únicas (la de mejor señal por nombre), ordenadas por señal."""
    best = {}
    for line in output.splitlines():
        if not line.strip():
            continue
        fields = split_terse(line)
        if len(fields) < 4:
            continue
        in_use, ssid, signal, security = fields[:4]
        if not ssid:
            continue  # redes ocultas
        net = {
            "ssid": ssid,
            "signal": int(signal) if signal.isdigit() else 0,
            "secure": security not in ("", "--"),
            "active": in_use.strip() == "*",
        }
        prev = best.get(ssid)
        if prev is None or net["signal"] > prev["signal"] or net["active"]:
            if prev is not None:
                net["active"] = net["active"] or prev["active"]
            best[ssid] = net
    return sorted(best.values(), key=lambda n: (not n["active"], -n["signal"], n["ssid"].lower()))


def signal_bars(signal):
    level = 0 if signal < 20 else 1 if signal < 40 else 2 if signal < 60 else 3 if signal < 80 else 4
    return "".join(ch if i < level else "·" for i, ch in enumerate("▂▄▆█"))


def nmcli(*args, timeout=45):
    try:
        res = subprocess.run(["nmcli", *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as err:
        return False, str(err)
    return res.returncode == 0, (res.stdout or res.stderr).strip()


def wifi_device():
    ok, out = nmcli("-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device")
    if not ok:
        return None
    for line in out.splitlines():
        dev, typ, state, conn = (split_terse(line) + ["", "", "", ""])[:4]
        if typ == "wifi":
            return {"device": dev, "state": state, "connection": conn}
    return None


def known_connections():
    ok, out = nmcli("-t", "-f", "NAME,TYPE", "connection", "show")
    names = set()
    if ok:
        for line in out.splitlines():
            fields = split_terse(line)
            if len(fields) >= 2 and fields[1] in ("802-11-wireless", "wifi"):
                names.add(fields[0])
    return names


def scan():
    ok, out = nmcli("-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list", "--rescan", "yes")
    return parse_networks(out) if ok else []


def friendly_error(out):
    """Traduce los errores más comunes de NetworkManager."""
    low = out.lower()
    if "secrets were required" in low or "802-1x" in low or "invalid passphrase" in low or "psk" in low:
        return "La contraseña es incorrecta."
    if "no network with ssid" in low:
        return "La red ya no está disponible. Buscá de nuevo."
    if "timeout" in low or "timed out" in low:
        return "La red no respondió a tiempo. Acercate al router y probá de nuevo."
    return out[:300] or "Error desconocido."


def connect(net, password=None, known=False):
    if known:
        return nmcli("connection", "up", "id", net["ssid"], timeout=60)
    args = ["device", "wifi", "connect", net["ssid"]]
    if password:
        args += ["password", password]
    ok, out = nmcli(*args, timeout=60)
    if not ok:
        # nmcli deja el perfil creado aunque falle: se borra para no recordar una clave mala.
        nmcli("connection", "delete", "id", net["ssid"])
    return ok, out


# --- Interfaz -----------------------------------------------------------------

OSK_LAYOUTS = {
    "abc": ["1234567890", "qwertyuiop", "asdfghjkl", "zxcvbnm,.-"],
    "ABC": ["1234567890", "QWERTYUIOP", "ASDFGHJKL", "ZXCVBNM;:_"],
    "#+=": ["!@#$%^&*()", "-_=+[]{}|\\", "'\";:/?<>,.", "`~€£¥ "],
}
OSK_ACTIONS = ["Mayús", "#+=", "Espacio", "Borrar", "Mostrar", "Listo", "Cancelar"]


class App:
    def __init__(self, scr):
        self.scr = scr
        self.networks = []
        self.known = set()
        self.status = None
        self.sel = 0
        curses.curs_set(0)
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)   # selección
        curses.init_pair(2, curses.COLOR_GREEN, -1)                  # conectada
        curses.init_pair(3, curses.COLOR_YELLOW, -1)                 # avisos
        curses.init_pair(4, curses.COLOR_CYAN, -1)                   # títulos

    # Pantallas auxiliares

    def message(self, text, wait=True):
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        for i, line in enumerate(text.splitlines()):
            self.scr.addstr(h // 2 - 1 + i, 2, line[: w - 4])
        if wait:
            self.scr.addstr(h - 2, 2, "A / Enter: continuar", curses.color_pair(3))
        self.scr.refresh()
        if wait:
            while read_key(self.scr) not in ("enter", "esc"):
                pass

    def refresh_data(self):
        self.message("Buscando redes Wi-Fi...", wait=False)
        self.status = wifi_device()
        if self.status is None:
            return
        ok, radio = nmcli("radio", "wifi")
        if ok and radio == "disabled":
            nmcli("radio", "wifi", "on")
        self.networks = scan()
        self.known = known_connections()
        self.sel = min(self.sel, max(0, len(self.networks) - 1))

    # Lista de redes

    def draw_list(self):
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        self.scr.addstr(0, 2, "Wi-Fi", curses.color_pair(4) | curses.A_BOLD)
        st = self.status
        if st and st["state"].startswith("connected") and st["connection"]:
            self.scr.addstr(1, 2, f"Conectado a «{st['connection']}»", curses.color_pair(2))
        else:
            self.scr.addstr(1, 2, "Sin conexión. Elegí una red:")
        if not self.networks:
            self.scr.addstr(3, 2, "No se encontraron redes. Y: buscar de nuevo.", curses.color_pair(3))
        top = 3
        rows = h - top - 2
        start = max(0, min(self.sel - rows // 2, len(self.networks) - rows))
        for i, net in enumerate(self.networks[start : start + rows]):
            idx = start + i
            tags = []
            if net["active"]:
                tags.append("conectada")
            elif net["ssid"] in self.known:
                tags.append("guardada")
            tags.append("con clave" if net["secure"] else "abierta")
            line = f" {signal_bars(net['signal'])}  {net['ssid'][: w - 40]:<{max(10, w - 40)}} {' · '.join(tags)}"
            attr = curses.color_pair(1) if idx == self.sel else (curses.color_pair(2) if net["active"] else 0)
            self.scr.addstr(top + i, 1, line[: w - 2].ljust(w - 2), attr)
        help_text = "A: conectar   B: salir   Y: buscar de nuevo   X: desconectar / olvidar"
        self.scr.addstr(h - 1, 2, help_text[: w - 4], curses.color_pair(3))
        self.scr.refresh()

    def run(self):
        self.refresh_data()
        if self.status is None:
            self.message("No se encontró una placa Wi-Fi.\nRevisá el Reporte de hardware.")
            return
        while True:
            self.draw_list()
            key = read_key(self.scr)
            last = max(0, len(self.networks) - 1)
            if key == "up":
                self.sel = max(0, self.sel - 1)
            elif key == "down":
                self.sel = min(last, self.sel + 1)
            elif key == "pgup":
                self.sel = max(0, self.sel - 10)
            elif key == "pgdn":
                self.sel = min(last, self.sel + 10)
            elif key in ("tab", "r", "R"):
                self.refresh_data()
            elif key in ("esc", "q"):
                return
            elif key == "back" and self.networks:
                self.manage(self.networks[self.sel])
            elif key == "enter" and self.networks:
                self.join(self.networks[self.sel])

    def join(self, net):
        if net["active"]:
            self.message(f"Ya estás conectado a «{net['ssid']}».")
            return
        known = net["ssid"] in self.known
        password = None
        title = f"Contraseña de «{net['ssid']}»"
        if net["secure"] and not known:
            password = self.keyboard(title)
            if password is None:
                return
        while True:
            self.message(f"Conectando a «{net['ssid']}»...", wait=False)
            ok, out = connect(net, password, known)
            if ok:
                self.message(f"Conectado a «{net['ssid']}».")
                break
            error = friendly_error(out)
            if not net["secure"] or error != "La contraseña es incorrecta.":
                self.message(f"No se pudo conectar a «{net['ssid']}»:\n{error}")
                break
            # Clave mala (nueva o la guardada cambió): se olvida y se pide de nuevo.
            if known:
                nmcli("connection", "delete", "id", net["ssid"])
                known = False
            password = self.keyboard(f"Contraseña incorrecta. {title}")
            if password is None:
                break
        self.refresh_data()

    def manage(self, net):
        options = []
        if net["active"]:
            options.append(("Desconectar", lambda: nmcli("device", "disconnect", self.status["device"])))
        if net["ssid"] in self.known:
            options.append(("Olvidar esta red", lambda: nmcli("connection", "delete", "id", net["ssid"])))
        if not options:
            self.message(f"«{net['ssid']}» no está guardada.")
            return
        options.append(("Cancelar", None))
        sel = 0
        while True:
            self.scr.erase()
            self.scr.addstr(1, 2, f"«{net['ssid']}»", curses.color_pair(4) | curses.A_BOLD)
            for i, (label, _) in enumerate(options):
                self.scr.addstr(3 + i, 4, f" {label} ", curses.color_pair(1) if i == sel else 0)
            self.scr.refresh()
            key = read_key(self.scr)
            if key == "up":
                sel = (sel - 1) % len(options)
            elif key == "down":
                sel = (sel + 1) % len(options)
            elif key == "esc":
                return
            elif key == "enter":
                action = options[sel][1]
                if action:
                    ok, out = action()
                    self.message("Listo." if ok else f"Error:\n{out[:300]}")
                    self.refresh_data()
                return

    # Teclado en pantalla

    def keyboard(self, title):
        text = ""
        layout = "abc"
        show = False
        row, col = 1, 0
        while True:
            keys = OSK_LAYOUTS[layout]
            grid = [list(r) for r in keys] + [OSK_ACTIONS]
            row = min(row, len(grid) - 1)
            col = min(col, len(grid[row]) - 1)
            self.scr.erase()
            h, w = self.scr.getmaxyx()
            self.scr.addstr(1, 2, title[: w - 4], curses.color_pair(4) | curses.A_BOLD)
            shown = text if show else "•" * len(text)
            self.scr.addstr(3, 2, f"[ {shown[-(w - 10):]:<{max(8, min(len(shown) + 1, w - 10))}} ]")
            for r, items in enumerate(grid):
                y = 6 + r * 2
                x = 4
                for c, item in enumerate(items):
                    label = " ␣ " if item == " " else f" {item} "
                    attr = curses.color_pair(1) | curses.A_BOLD if (r, c) == (row, col) else 0
                    if x + len(label) < w - 1:
                        self.scr.addstr(y, x, label, attr)
                    x += len(label) + 1
            self.scr.addstr(h - 1, 2, "A: escribir   X: borrar   Y: listo   B: cancelar"[: w - 4], curses.color_pair(3))
            self.scr.refresh()

            key = read_key(self.scr)
            if key == "up":
                row = (row - 1) % len(grid)
            elif key == "down":
                row = (row + 1) % len(grid)
            elif key == "left":
                col = (col - 1) % len(grid[row])
            elif key == "right":
                col = (col + 1) % len(grid[row])
            elif key == "esc":
                return None
            elif key == "tab":
                return text
            elif key == "back":
                text = text[:-1]
            elif key == "enter":
                item = grid[row][col]
                if row < len(keys):
                    text += item
                elif item == "Mayús":
                    layout = "ABC" if layout == "abc" else "abc"
                elif item == "#+=":
                    layout = "#+=" if layout != "#+=" else "abc"
                elif item == "Espacio":
                    text += " "
                elif item == "Borrar":
                    text = text[:-1]
                elif item == "Mostrar":
                    show = not show
                elif item == "Listo":
                    return text
                elif item == "Cancelar":
                    return None
            elif len(key) == 1 and key.isprintable():
                # Teclado físico: se escribe directo.
                text += key


def main(scr):
    App(scr).run()


if __name__ == "__main__":
    locale.setlocale(locale.LC_ALL, "")
    curses.wrapper(main)
